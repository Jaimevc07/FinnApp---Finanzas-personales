# Copia este archivo como .env.local (en local) y configura las mismas variables en Vercel.
# Nunca pongas aquí valores reales: este archivo se sube al repositorio.

# Cadena de conexión a Postgres de Supabase por el pooler en modo transacción (puerto 6543).
# Supabase → Connect → "Transaction pooler". Ejemplo:
# postgresql://postgres.<id-del-proyecto>:<contraseña>@aws-1-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Inicio de sesión (Supabase Auth). Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://<id-del-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Clave secreta: solo en el servidor (crea las cuentas de los miembros). Nunca con NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Opcionales:
# DB_SCHEMA=prueba          # usar otro esquema de Postgres (p. ej. para pruebas). Por defecto: public
# DB_MAX_CONEXIONES=3       # conexiones por instancia del servidor
